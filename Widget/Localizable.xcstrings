    "Within 24 hours of your last cigarette, the carbon monoxide level in your blood returns to normal." : {
      "comment" : "Estimated health fact from the bundled remote-content seed.",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Innerhalb von 24 Stunden nach Ihrer letzten Zigarette normalisiert sich der Kohlenmonoxidspiegel in Ihrem Blut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dentro de las 24 horas posteriores a su último cigarrillo, el nivel de monóxido de carbono en la sangre vuelve a la normalidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans les 24 heures suivant votre dernière cigarette, le taux de monoxyde de carbone dans votre sang revient à la normale."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entro 24 ore dall'ultima sigaretta, il livello di monossido di carbonio nel sangue ritorna normale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最後にタバコを吸ってから 24 時間以内に、血液中の一酸化炭素濃度は正常に戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마지막 담배를 피운 후 24시간 이내에 혈액 내 일산화탄소 수치가 정상으로 돌아옵니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W ciągu 24 godzin od wypalenia ostatniego papierosa poziom tlenku węgla we krwi wraca do normy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dentro de 24 horas após o seu último cigarro, o nível de monóxido de carbono no sangue volta ao normal."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son sigaranızı içtikten 24 saat sonra kanınızdaki karbon monoksit düzeyi normale döner."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Протягом 24 годин після вашої останньої сигарети рівень чадного газу в крові повертається до норми."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在您最后一支烟后 24 小时内，您血液中的一氧化碳水平会恢复正常。"
          }
        }
      }
    },
