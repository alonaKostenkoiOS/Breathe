    "Most people notice food tasting better within just two days of their last cigarette." : {
      "comment" : "Estimated offline health fact; preserve the qualifier most people.",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die meisten Menschen bemerken bereits zwei Tage nach der letzten Zigarette, dass ihr Essen besser schmeckt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mayoría de las personas notan que la comida sabe mejor apenas dos días después de fumar su último cigarrillo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La plupart des gens remarquent que les aliments ont meilleur goût deux jours seulement après leur dernière cigarette."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La maggior parte delle persone nota che il cibo ha un sapore migliore entro soli due giorni dall'ultima sigaretta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ほとんどの人は、最後にタバコを吸ってからわずか 2 日以内に食べ物が美味しくなったことに気づきます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대부분의 사람들은 마지막 담배를 피운 지 이틀 만에 음식의 맛이 더 좋아진다는 것을 느낍니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Większość ludzi zauważa, że ​​jedzenie smakuje lepiej już po dwóch dniach od wypalenia ostatniego papierosa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A maioria das pessoas percebe que a comida fica mais saborosa apenas dois dias após o último cigarro."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çoğu insan, son sigarayı içtikten sadece iki gün sonra yemeğin tadının daha iyi olduğunu fark eder."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Більшість людей помічають покращення смаку їжі лише через два дні після останньої сигарети."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大多数人在吸完最后一支烟后的两天内就注意到食物的味道更好了。"
          }
        }
      }
    },
