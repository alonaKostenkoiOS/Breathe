    "Changing the language does not change your currency, quit date, or saved progress." : {
      "comment" : "Language setting privacy and data reassurance.",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Ändern der Sprache hat keine Auswirkungen auf Ihre Währung, Ihr Beendigungsdatum oder Ihren gespeicherten Fortschritt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambiar el idioma no cambia su moneda, fecha de salida ni progreso guardado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changer la langue ne change pas votre devise, votre date de sortie ou votre progression enregistrée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La modifica della lingua non modifica la valuta, la data di uscita o i progressi salvati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "言語を変更しても、通貨、終了日、保存された進行状況は変更されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "언어를 변경해도 통화, 종료 날짜 또는 저장된 진행 상황은 변경되지 않습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmiana języka nie powoduje zmiany waluty, daty zakończenia ani zapisanego postępu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alterar o idioma não altera sua moeda, data de encerramento ou progresso salvo."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dili değiştirmek para biriminizi, çıkış tarihinizi veya kaydedilen ilerlemenizi değiştirmez."
          }
        },
        "uk" : {
          "stringUnit" : {
