    "A peaceful path through green hills toward sunrise" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein friedlicher Weg durch grüne Hügel dem Sonnenaufgang entgegen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un camino tranquilo a través de colinas verdes hacia el amanecer."
