    "Hold a pen, glass, or small object. Try water, gum, or a crunchy snack if one is nearby." : {
      "comment" : "Hands-and-mouth replacement exercise instruction.",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halten Sie einen Stift, ein Glas oder einen kleinen Gegenstand. Versuchen Sie es mit Wasser, Kaugummi oder einem knusprigen Snack, falls einer in der Nähe ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sostenga un bolígrafo, un vaso o un objeto pequeño. Pruebe con agua, chicle o un refrigerio crujiente si hay uno cerca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenez un stylo, un verre ou un petit objet. Essayez de l'eau, de la gomme ou une collation croustillante s'il y en a une à proximité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni una penna, un bicchiere o un piccolo oggetto. Prova acqua, gomma o uno spuntino croccante se ce n'è uno nelle vicinanze."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ペン、ガラス、または小さな物体を持ちます。水、ガム、またはカリカリのスナックが近くにある場合は、それらを試してみてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "펜, 유리잔, 작은 물건을 잡으세요. 물, 껌, 바삭바삭한 간식이 근처에 있으면 먹어 보세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trzymaj długopis, szklankę lub mały przedmiot. Spróbuj wody, gumy lub chrupiącej przekąski, jeśli taka jest w pobliżu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segure uma caneta, um copo ou um objeto pequeno. Experimente água, chiclete ou um lanche crocante, se houver algum por perto."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir kalem, bardak veya küçük bir nesne tutun. Yakınınızdaysa su, sakız veya gevrek bir atıştırmalık deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тримайте ручку, склянку або невеликий предмет. Спробуйте воду, жуйку або хрустку закуску, якщо є поблизу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "握住一支笔、玻璃杯或小物体。如果附近有水、口香糖或松脆的零食，请尝试一下。"
          }
        }
      }
    },
