    "gambling.safety.self_harm" : {
      "comment" : "Gambling crisis screening. Requires specialist review.",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glücksspielbedingte Belastungen haben zu Gedanken an Selbstverletzung oder Selbstmord geführt"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gambling-related distress has led to thoughts of self-harm or suicide"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La angustia relacionada con el juego ha llevado a pensamientos de autolesión o suicidio"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
