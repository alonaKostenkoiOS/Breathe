        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twój plan rzucenia palenia i wszystkie dotychczasowe postępy pozostają niezmienione w Breathe Nicotine. Możesz przeglądać inne programy, kiedy tylko będziesz gotowy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu plano de abandono e todo o progresso existente permanecem inalterados no Breathe Nicotine. Você pode explorar outros programas sempre que estiver pronto."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
