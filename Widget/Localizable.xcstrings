    "Health recovery times are estimates and can vary from person to person." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Erholungszeiten für die Gesundheit sind Schätzungen und können von Person zu Person variieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los tiempos de recuperación de la salud son estimados y pueden variar de persona a persona."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les temps de récupération de la santé sont des estimations et peuvent varier d'une personne à l'autre."
          }
        },
        "it" : {
          "stringUnit" : {
