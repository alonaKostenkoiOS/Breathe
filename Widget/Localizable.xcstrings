    "strategy.urge_surf.instruction" : {
      "comment" : "Program Rescue strategy instruction.",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nehmen Sie den Drang wahr, ohne dagegen anzukämpfen, und geben Sie ihm Zeit, sich zu ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
