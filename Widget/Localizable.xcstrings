    "Each entry helps reveal when a little extra support could help." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Eintrag zeigt, wann ein wenig zusätzliche Unterstützung hilfreich sein könnte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada entrada ayuda a revelar cuándo podría ser útil un poco de apoyo adicional."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque entrée permet de révéler quand un peu de soutien supplémentaire pourrait aider."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni voce aiuta a rivelare quando un piccolo supporto extra potrebbe essere d'aiuto."
