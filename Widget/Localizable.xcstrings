    "gambling.safety.detail" : {
      "comment" : "Gambling safety scope.",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atmen kann Ihnen dabei helfen, Ihren Drang zu unterbrechen und Selbstausschluss oder berufliche Ressourcen zu erreichen. Es handelt sich nicht um eine Behandlung oder Finanzberatung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathe can help you pause urges and reach self-exclusion or professional resources. It is not treatment or financial advice."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathe puede ayudarle a detener los impulsos y alcanzar la autoexclusión o recursos profesionales. No es un tratamiento ni un asesoramiento financiero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respirer peut vous aider à mettre vos envies en pause et à atteindre l’auto-exclusion ou des ressources professionnelles. Il ne s’agit pas d’un traitement ou de conseils financiers."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathe può aiutarti a mettere in pausa gli impulsi e raggiungere l'autoesclusione o le risorse professionali. Non è un trattamento o una consulenza finanziaria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "呼吸は衝動を一時停止し、自己排除や専門的なリソースに到達するのに役立ちます。それは治療や経済的なアドバイスではありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "호흡은 충동을 멈추고 자기 배제 또는 전문적인 자원에 접근하는 데 도움이 될 수 있습니다. 이는 치료나 재정적 조언이 아닙니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oddychaj może pomóc Ci wstrzymać popędy i osiągnąć samowykluczenie lub zasoby zawodowe. To nie jest leczenie ani porada finansowa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breathe pode ajudá-lo a pausar os impulsos e alcançar a autoexclusão ou recursos profissionais. Não é tratamento ou aconselhamento financeiro."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nefes almak, dürtülerinizi durdurmanıza ve kendini dışlama ya da profesyonel kaynaklara ulaşmanıza yardımcı olabilir. Tedavi veya mali tavsiye değildir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дихання може допомогти вам призупинити бажання та досягти самовідчуження або професійних ресурсів. Це не лікування чи фінансова порада."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "呼吸可以帮助您暂停冲动并获得自我排除或专业资源。这不是治疗或财务建议。"
          }
        }
      }
    },
