    "Bronchial tubes relax and lung capacity increases, making breathing easier." : {
      "comment" : "Estimated health milestone detail.",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Bronchien entspannen sich und die Lungenkapazität erhöht sich, wodurch das Atmen erleichtert wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los bronquios se relajan y la capacidad pulmonar aumenta, facilitando la respiración."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les trompes bronchiques se détendent et la capacité pulmonaire augmente, facilitant ainsi la respiration."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I bronchi si rilassano e la capacità polmonare aumenta, facilitando la respirazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "気管支が弛緩して肺活量が増加し、呼吸が楽になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기관지가 이완되고 폐활량이 증가하여 호흡이 쉬워집니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oskrzela rozluźniają się, a pojemność płuc wzrasta, co ułatwia oddychanie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os brônquios relaxam e a capacidade pulmonar aumenta, facilitando a respiração."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bronş tüpleri gevşer ve akciğer kapasitesi artarak nefes almayı kolaylaştırır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бронхи розслабляються, а об’єм легенів збільшується, що полегшує дихання."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
