    "gambling.safety.warning" : {
      "comment" : "Gambling crisis warning; localized resources must be supplied by country.",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du verdienst jetzt direkte Unterstützung. Wende dich sofort an einen örtlichen Notfall- oder Krisendienst oder an eine vertraute Person."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You deserve immediate human support. Contact local emergency or crisis services, or a person you trust, now."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mereces recibir apoyo humano de inmediato. Contacta ahora con los servicios locales de emergencias o de atención en crisis, o con alguien de confianza."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous méritez un soutien humain immédiat. Contactez dès maintenant les services d’urgence ou d’aide en situation de crise de votre région, ou une personne de confiance."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meriti subito il sostegno di una persona. Contatta ora i servizi locali di emergenza o di supporto nelle crisi, oppure una persona di fiducia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今すぐ人の支援を受けてください。地域の緊急窓口や相談窓口、または信頼できる人に、今すぐ連絡してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금 바로 사람의 도움을 받을 자격이 있습니다. 지역 응급·위기 지원 기관이나 믿을 수 있는 사람에게 즉시 연락하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zasługujesz na natychmiastowe wsparcie drugiej osoby. Skontaktuj się teraz z lokalnymi służbami ratunkowymi, ośrodkiem interwencji kryzysowej lub zaufaną osobą."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você merece apoio humano imediato. Entre em contato agora com um serviço local de emergência ou apoio em crise, ou com alguém de confiança."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şu anda doğrudan insan desteğini hak ediyorsunuz. Hemen yerel acil yardım veya kriz destek hizmetleriyle ya da güvendiğiniz biriyle iletişime geçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ви заслуговуєте на негайну підтримку небайдужої людини. Просто зараз зверніться до місцевої екстреної або кризової служби чи до людини, якій довіряєте."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你值得立即获得他人的支持。请马上联系当地急救或危机援助服务，或联系你信任的人。"
          }
        }
      }
    },
