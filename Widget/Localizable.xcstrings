    "Stand up and move somewhere different. If you can, walk for a minute and take a sip of water." : {
      "comment" : "Change-scene exercise instruction.",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stehen Sie auf und gehen Sie woanders hin. Wenn Sie können, gehen Sie eine Minute lang und trinken Sie einen Schluck Wasser."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Levántate y muévete a un lugar diferente. Si puedes, camina un minuto y toma un sorbo de agua."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Levez-vous et déplacez-vous vers un endroit différent. Si vous le pouvez, marchez une minute et buvez une gorgée d’eau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alzati e spostati in un posto diverso. Se puoi, cammina per un minuto e bevi un sorso d'acqua."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "立ち上がって、どこか別の場所に移動してください。可能であれば、1分間歩いて水を一口飲んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일어나서 다른 곳으로 이동하세요. 가능하다면 잠시 걷고 물을 한 모금 마셔보세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wstań i przenieś się w inne miejsce. Jeśli możesz, przejdź się przez minutę i wypij łyk wody."
          }
        },
        "pt-BR" : {
