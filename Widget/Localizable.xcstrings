    "Take one slow breath. Breathe is ready when you are." : {
      "comment" : "Supportive App Intent response.",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atme einmal langsam ein. Breathe ist bereit, wenn Sie es sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respira lentamente. Breathe está listo cuando tú lo estés."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prenez une respiration lente. La respiration est prête quand vous l’êtes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai un respiro lento. Breathe è pronto quando lo sei tu."
          }
        },
