    "Read your reason slowly. Imagine the next choice that keeps you moving toward it." : {
      "comment" : "Motivation exercise instruction.",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lesen Sie Ihre Begründung langsam durch. Stellen Sie sich die nächste Wahl vor, die Sie dazu bringt, darauf zuzugehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lea su razón lentamente. Imagina la siguiente elección que te mantendrá avanzando hacia ella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisez lentement votre raison. Imaginez le prochain choix qui vous permettra d’y parvenir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leggi lentamente il tuo motivo. Immagina la prossima scelta che ti spinge verso di essa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "理由をゆっくり読んでください。あなたがそれに向かって前進し続ける次の選択を想像してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이유를 천천히 읽어보세요. 당신을 계속해서 나아가게 만드는 다음 선택을 상상해 보세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przeczytaj powoli swój powód. Wyobraź sobie kolejny wybór, który sprawi, że będziesz zmierzać w jego stronę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leia seu motivo lentamente. Imagine a próxima escolha que o mantém avançando nessa direção."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nedeninizi yavaşça okuyun. Sizi ona doğru ilerletecek bir sonraki seçeneği hayal edin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повільно прочитайте свою причину. Уявіть наступний вибір, який змушує вас рухатися до нього."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "慢慢读你的理由。想象一下下一个让你继续前进的选择。"
          }
        }
      }
    },
