    "program.delete.detail" : {
      "comment" : "Program deletion consequence.",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden die Dränge, Pläne, Risikofenster und der Verlauf des Programms entfernt. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This removes the program’s urges, plans, risk windows, and history. This cannot be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto elimina los impulsos, los planes, las ventanas de riesgo y el historial del programa. Esto no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela supprime les envies, les plans, les fenêtres de risque et l’historique du programme. Cela ne peut pas être annulé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciò rimuove gli impulsi, i piani, le finestre di rischio e la cronologia del programma. Questa operazione non può essere annullata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これにより、プログラムの衝動、計画、リスクウィンドウ、および履歴が削除されます。これを元に戻すことはできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이렇게 하면 프로그램의 충동, 계획, 위험 창 및 기록이 제거됩니다. 이 작업은 취소할 수 없습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usuwa to potrzeby, plany, okna ryzyka i historię programu. Tego nie można cofnąć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso remove os impulsos, planos, janelas de risco e histórico do programa. Isto não pode ser desfeito."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu, programın dürtülerini, planlarını, risk pencerelerini ve geçmişini kaldırır. Bu geri alınamaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Це видаляє заклики, плани, вікна ризику та історію програми. Це неможливо скасувати."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这消除了该计划的冲动、计划、风险窗口和历史记录。此操作无法撤消。"
          }
        }
      }
    },
