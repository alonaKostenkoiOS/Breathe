    "digital.screen_time.fallback" : {
      "comment" : "Graceful fallback when FamilyControls entitlement is unavailable.",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für die Steuerung der Bildschirmzeit sind Apple-Berechtigungen erforderlich. Breathe unterstützt weiterhin manuelle Pausen, Timer und Drangprotokollierung ohne diese."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screen Time controls require Apple entitlements. Breathe still supports manual pauses, timers, and urge logging without them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los controles de Screen Time requieren derechos de Apple. Breathe todavía admite pausas manuales, temporizadores y registros de impulsos sin ellos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les contrôles Screen Time nécessitent des droits Apple. Breathe prend toujours en charge les pauses manuelles, les minuteries et l'enregistrement des envies sans eux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I controlli del tempo di utilizzo richiedono i diritti Apple. Breathe supporta ancora pause manuali, timer e registrazione degli impulsi senza di essi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スクリーンタイムのコントロールには Apple のライセンスが必要です。 Breathe は、手動による一時停止、タイマー、およびそれらを使用しない緊急ログを引き続きサポートします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "화면 시간을 제어하려면 Apple 자격이 필요합니다. Breathe는 이러한 기능 없이도 수동 일시 중지, 타이머 및 긴급 기록을 지원합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sterowanie czasem ekranowym wymaga uprawnień Apple. Breathe nadal obsługuje ręczne pauzy, liczniki czasu i rejestrowanie impulsów bez nich."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os controles de tempo de tela exigem direitos da Apple. O Breathe ainda oferece suporte a pausas manuais, cronômetros e registro de urgência sem eles."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekran Süresi kontrolleri Apple yetkilerini gerektirir. Breathe hala manuel duraklatmaları, zamanlayıcıları ve bunlar olmadan dürtü günlüğünü destekliyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для керування екранним часом потрібні права Apple. Breathe все ще підтримує ручні паузи, таймери та реєстрацію запитів без них."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "屏幕时间控制需要 Apple 权利。呼吸仍然支持手动暂停、计时器和紧急记录，无需它们。"
          }
        }
      }
    },
