    "platform.migration.detail" : {
      "comment" : "Legacy nicotine migration reassurance.",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr Entwöhnungsplan und alle bisherigen Fortschritte bleiben bei Breathe Nicotine unverändert. Sie können jederzeit andere Programme erkunden."
          }
        },
        "en" : {
          "stringUnit" : {
