    "A daily reminder of how your body recovers while you stay smoke-free." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine tägliche Erinnerung daran, wie sich Ihr Körper erholt, während Sie rauchfrei bleiben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un recordatorio diario de cómo se recupera su cuerpo mientras permanece libre de humo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un rappel quotidien de la façon dont votre corps récupère pendant que vous restez sans fumée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un promemoria quotidiano su come il tuo corpo si riprende mentre rimani senza fumo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "禁煙中に体がどのように回復するかを毎日思い出させます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "금연을 유지하는 동안 신체가 어떻게 회복되는지 매일 상기시켜 드립니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codzienne przypomnienie o tym, jak Twoje ciało regeneruje się, gdy nie palisz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um lembrete diário de como seu corpo se recupera enquanto você não fuma."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sigarasız kaldığınızda vücudunuzun nasıl iyileştiğini gösteren günlük bir hatırlatma."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щоденне нагадування, як відновлюється тіло, поки ви без цигарок."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每天提醒您在不吸烟的情况下身体如何恢复。"
          }
        }
      }
    },
    "A few details and Breathe will track every hour, cigarette and dollar you reclaim." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein paar Details und Breathe verfolgt jede Stunde, jede Zigarette und jeden Dollar, den Sie zurückfordern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unos pocos detalles y Breathe rastreará cada hora, cigarrillo y dólar que reclames."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quelques détails et Breathe suivra chaque heure, cigarette et dollar que vous récupérez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pochi dettagli e Breathe terrà traccia di ogni ora, sigaretta e dollaro che recuperi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いくつかの詳細を確認すると、Breathe が時間ごとに、タバコとドルを回収して追跡します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "몇 가지 세부 정보와 Breathe는 귀하가 회수한 담배, 달러 등을 매시간 추적합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kilka szczegółów, a Breathe będzie śledzić każdą godzinę, papierosa i dolara, które odzyskasz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alguns detalhes e o Breathe rastreará cada hora, cigarro e dólar que você recuperar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Birkaç ayrıntı ve Breathe, geri kazandığınız her saati, sigarayı ve doları takip edecektir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кілька деталей — і Breathe рахуватиме кожну годину, цигарку й гривню, які ви повертаєте собі."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一些细节和呼吸将跟踪您回收的每小时、香烟和美元。"
          }
        }
      }
    },
