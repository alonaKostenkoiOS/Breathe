    "alcohol.transport.detail" : {
      "comment" : "Alcohol safe transport action.",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie Alkohol getrunken haben, organisieren Sie einen sicheren Weg nach Hause oder wenden Sie sich an jemanden, dem Sie vertrauen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you have been drinking, arrange a safe way home or contact someone you trust."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si ha estado bebiendo, organice un camino seguro a casa o comuníquese con alguien de su confianza."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous avez bu, organisez un moyen sûr de rentrer chez vous ou contactez une personne de confiance."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se hai bevuto, organizza un percorso sicuro per tornare a casa o contatta qualcuno di cui ti fidi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "飲酒した場合は、安全な帰り道を手配するか、信頼できる人に連絡してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "술을 마셨다면 집으로 안전하게 돌아갈 수 있는 방법을 마련하거나 믿을 수 있는 사람에게 연락하십시오."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli piłeś, zorganizuj bezpieczną drogę do domu lub skontaktuj się z zaufaną osobą."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se você bebeu, providencie um caminho seguro para casa ou entre em contato com alguém de sua confiança."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İçki içiyorsanız, eve güvenli bir yol ayarlayın veya güvendiğiniz biriyle iletişime geçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо ви пили, організуйте безпечну дорогу додому або зверніться до людини, якій довіряєте."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果您喝酒了，请安排一条安全的回家路或联系您信任的人。"
          }
        }
      }
    },
