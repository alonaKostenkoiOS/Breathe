    "Follow the circle. Breathe in gently as it grows, then breathe out as it becomes smaller." : {
      "comment" : "Breathing exercise instruction.",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folgen Sie dem Kreis. Atmen Sie sanft ein, während es wächst, und atmen Sie dann aus, wenn es kleiner wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sigue el círculo. Inhale suavemente a medida que crece, luego exhale a medida que se hace más pequeño."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suivez le cercle. Inspirez doucement à mesure qu'il grandit, puis expirez à mesure qu'il diminue."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segui il cerchio. Inspira delicatamente mentre cresce, quindi espira quando diventa più piccolo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サークルに従ってください。大きくなるにつれてゆっくりと息を吸い、小さくなるにつれて息を吐きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "원을 따라가세요. 자라면서 천천히 숨을 들이쉬고, 작아지면 숨을 내쉰다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podążaj za okręgiem. Wdychaj delikatnie, gdy rośnie, a następnie wydychaj, gdy staje się mniejszy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siga o círculo. Inspire suavemente à medida que ele cresce e depois expire à medida que ele fica menor."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çemberi takip edin. Büyüdükçe yavaşça nefes alın, küçüldükçe nefes verin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Слідкуйте за колом. Зробіть легкий вдих, коли він росте, потім видихніть, коли він стає меншим."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "跟着圆圈走。当它长大时轻轻地吸气，然后当它变小时呼气。"
          }
        }
      }
    },
