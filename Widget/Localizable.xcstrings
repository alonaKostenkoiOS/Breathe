    "Risk of several cancers falls and stroke risk approaches that of a non-smoker." : {
      "comment" : "Estimated health milestone detail.",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Risiko für mehrere Krebsarten sinkt und das Schlaganfallrisiko nähert sich dem eines Nichtrauchers an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El riesgo de sufrir varios tipos de cáncer disminuye y el riesgo de sufrir un accidente cerebrovascular se acerca al de un no fumador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le risque de plusieurs cancers, de chutes et d'accidents vasculaires cérébraux se rapproche de celui d'un non-fumeur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il rischio di diversi tumori diminuisce e il rischio di ictus si avvicina a quello di un non fumatore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いくつかのがんのリスクは低下し、脳卒中のリスクは非喫煙者のリスクに近づきます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여러 가지 암에 걸릴 위험은 낮아지고 뇌졸중 위험은 비흡연자와 비슷해집니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ryzyko wystąpienia kilku nowotworów spada, a ryzyko udaru jest zbliżone do tego, jakie występuje u osoby niepalącej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O risco de vários tipos de câncer, quedas e risco de acidente vascular cerebral se aproxima do risco de um não fumante."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pek çok kanser türüne yakalanma riski düşer ve felç riski sigara içmeyen bir kişininkine yaklaşır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ризик кількох видів раку падає, а ризик інсульту наближається до ризику некурців."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "多种癌症的风险下降，中风的风险接近不吸烟者。"
          }
        }
      }
    },
