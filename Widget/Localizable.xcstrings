    "rescue.reflect.detail" : {
      "comment" : "Non-judgmental setback copy.",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das war ein schwieriger Moment. Was du gelernt und erreicht hast, zählt weiterhin."
