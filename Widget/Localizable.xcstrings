    "Blood flow improves, making walking and exercise noticeably easier." : {
      "comment" : "Estimated health milestone detail.",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Durchblutung verbessert sich, das Gehen und die sportliche Betätigung werden spürbar erleichtert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El flujo sanguíneo mejora, lo que facilita notablemente caminar y hacer ejercicio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La circulation sanguine s'améliore, ce qui rend la marche et l'exercice sensiblement plus faciles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il flusso sanguigno migliora, rendendo la camminata e l’esercizio notevolmente più facili."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "血流が良くなり、ウォーキングや運動が格段に楽になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "혈류가 개선되어 걷기와 운동이 눈에 띄게 쉬워집니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poprawia się przepływ krwi, dzięki czemu chodzenie i ćwiczenia stają się zauważalnie łatwiejsze."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O fluxo sanguíneo melhora, tornando a caminhada e os exercícios visivelmente mais fáceis."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
