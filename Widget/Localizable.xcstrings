    "Carbon monoxide in your blood falls to a normal level, so more oxygen reaches your organs." : {
      "comment" : "Estimated health milestone detail.",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Kohlenmonoxidgehalt in Ihrem Blut sinkt auf ein normales Niveau, sodass mehr Sauerstoff Ihre Organe erreicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El monóxido de carbono en la sangre cae a un nivel normal, por lo que llega más oxígeno a los órganos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le monoxyde de carbone dans votre sang tombe à un niveau normal, donc plus d'oxygène atteint vos organes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il monossido di carbonio nel sangue scende a un livello normale, quindi più ossigeno raggiunge i tuoi organi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "血液中の一酸化炭素は正常なレベルまで下がり、より多くの酸素が臓器に到達します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "혈액 내 일산화탄소가 정상 수준으로 떨어지므로 더 많은 산소가 장기에 도달합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tlenek węgla we krwi spada do normalnego poziomu, dzięki czemu do narządów dociera więcej tlenu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O monóxido de carbono no sangue cai para um nível normal, então mais oxigênio chega aos órgãos."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanınızdaki karbon monoksit normal seviyeye iner, dolayısıyla organlarınıza daha fazla oksijen ulaşır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чадний газ у вашій крові падає до нормального рівня, тому більше кисню досягає ваших органів."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "血液中的一氧化碳降至正常水平，因此更多的氧气到达您的器官。"
          }
        }
      }
    },
