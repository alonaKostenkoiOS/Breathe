    "One year smoke-free roughly halves your excess risk of coronary heart disease." : {
      "comment" : "Estimated offline health fact; preserve roughly.",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Jahr ohne Rauchen halbiert Ihr erhöhtes Risiko einer koronaren Herzkrankheit ungefähr um die Hälfte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un año sin fumar reduce aproximadamente a la mitad el riesgo excesivo de enfermedad coronaria."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un an sans fumée réduit environ de moitié votre risque excessif de maladie coronarienne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un anno senza fumo dimezza all’incirca il rischio in eccesso di malattia coronarica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 年間禁煙すると、冠状動脈性心臓病の過剰リスクがおよそ半分になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1년 동안 금연하면 관상동맥심장병에 걸릴 위험이 절반으로 줄어듭니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rok bez palenia zmniejsza o połowę ryzyko choroby niedokrwiennej serca."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um ano sem fumar reduz aproximadamente pela metade o risco excessivo de doença coronariana."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir yıl boyunca sigara içmemek, aşırı koroner kalp hastalığı riskinizi kabaca yarıya indirir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Один рік без куріння приблизно вдвічі знижує ваш надмірний ризик ішемічної хвороби серця."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "戒烟一年后，患冠心病的风险大约会降低一半。"
          }
        }
      }
