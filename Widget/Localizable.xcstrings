    "progress.personal.detail" : {
      "comment" : "Non-streak progress explanation.",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fortschritt ist mehr als eine perfekte Serie. Pausen und das, was Sie lernen, zählen beide."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Progress is more than a perfect streak. Pauses and what you learn both count."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El progreso es más que una racha perfecta. Las pausas y lo que aprendes cuentan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le progrès est plus qu’une séquence parfaite. Les pauses et ce que vous apprenez comptent tous deux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il progresso è più di una serie perfetta. Le pause e ciò che impari contano entrambi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "進歩は完璧な連続達成以上のものです。一時停止と学習内容の両方が重要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "발전은 완벽한 행진 그 이상입니다. 일시 정지와 배운 내용 모두 중요합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postęp to coś więcej niż doskonała passa. Liczą się zarówno przerwy, jak i to, czego się nauczysz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O progresso é mais do que uma sequência perfeita. As pausas e o que você aprende contam."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İlerleme mükemmel bir seriden daha fazlasıdır. Duraklamalar ve öğrendikleriniz her ikisi de önemlidir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прогрес – це більше, ніж ідеальна смуга. Враховуються і паузи, і те, що ви дізналися."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "进步不仅仅是完美的连胜。停顿和你学到的东西都很重要。"
          }
        }
      }
    },
