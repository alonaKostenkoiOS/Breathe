    "Goal reached — enjoy this moment." : { "localizations" : { "uk" : { "stringUnit" : { "state" : "translated", "value" : "Цілі досягнуто — порадійте цій миті." } } } },
    "Craving Rescue" : { "localizations" : { "uk" : { "stringUnit" : { "state" : "translated", "value" : "Допомога під час тяги" } } } },
