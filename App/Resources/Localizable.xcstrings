{
  "sourceLanguage" : "en",
  "strings" : {
    "We couldn’t load your history" : { "localizations" : { "uk" : { "stringUnit" : { "state" : "translated", "value" : "Не вдалося завантажити історію" } } } },
    "Your data is still on this device. Try loading it again." : { "localizations" : { "uk" : { "stringUnit" : { "state" : "translated", "value" : "Ваші дані залишаються на пристрої. Спробуйте завантажити їх ще раз." } } } },
