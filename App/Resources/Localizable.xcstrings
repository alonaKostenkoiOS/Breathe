    "I’m having a craving" : { "localizations" : { "uk" : { "stringUnit" : { "state" : "translated", "value" : "Мене тягне закурити" } } } },
    "Take a quiet minute with Breathe" : { "localizations" : { "uk" : { "stringUnit" : { "state" : "translated", "value" : "Зробіть спокійну паузу разом із Breathe" } } } },
    "Opens a guided breathing exercise" : { "localizations" : { "uk" : { "stringUnit" : { "state" : "translated", "value" : "Відкриває дихальну вправу" } } } },
    "What you’ve gained" : { "localizations" : { "uk" : { "stringUnit" : { "state" : "translated", "value" : "Що ви вже здобули" } } } },
    "Cigarettes avoided" : { "localizations" : { "uk" : { "stringUnit" : { "state" : "translated", "value" : "Невикурені цигарки" } } } },
