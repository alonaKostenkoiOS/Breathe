    "of cravings passed without smoking" : { "localizations" : { "uk" : { "stringUnit" : { "state" : "translated", "value" : "випадків тяги минули без куріння" } } } },
    "Your most common recent trigger was %@." : { "localizations" : { "uk" : { "stringUnit" : { "state" : "translated", "value" : "Найчастішим останнім тригером було: %@." } } } },
