    "Your body is recovering" : { "localizations" : { "uk" : { "stringUnit" : { "state" : "translated", "value" : "Ваше тіло відновлюється" } } } },
    "Every day without smoking gives your body more room to heal." : { "localizations" : { "uk" : { "stringUnit" : { "state" : "translated", "value" : "Кожен день без куріння допомагає тілу відновлюватися." } } } },
