    "Celebrate important recovery moments. You can change this anytime." : { "localizations" : { "uk" : { "stringUnit" : { "state" : "translated", "value" : "Відзначайте важливі моменти відновлення. Це можна змінити будь-коли." } } } },
    "App appearance" : { "localizations" : { "uk" : { "stringUnit" : { "state" : "translated", "value" : "Вигляд застосунку" } } } },
