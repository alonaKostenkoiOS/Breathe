    "Breathe out" : { "localizations" : { "uk" : { "stringUnit" : { "state" : "translated", "value" : "Видихайте" } } } },
    "This moment will pass. Stay with your breath." : { "localizations" : { "uk" : { "stringUnit" : { "state" : "translated", "value" : "Ця мить мине. Зосередьтеся на диханні." } } } },
    "Remember why you started" : { "localizations" : { "uk" : { "stringUnit" : { "state" : "translated", "value" : "Згадайте, чому ви почали" } } } },
    "Try this now" : { "localizations" : { "uk" : { "stringUnit" : { "state" : "translated", "value" : "Спробуйте зараз" } } } },
    "Stand up, change rooms, and take a sip of water." : { "localizations" : { "uk" : { "stringUnit" : { "state" : "translated", "value" : "Встаньте, перейдіть до іншої кімнати й зробіть ковток води." } } } },
