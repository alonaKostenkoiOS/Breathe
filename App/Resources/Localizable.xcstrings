    "Follow System" : { "localizations" : { "uk" : { "stringUnit" : { "state" : "translated", "value" : "Як у системі" } } } },
    "Breathe automatically supports Light and Dark Mode." : { "localizations" : { "uk" : { "stringUnit" : { "state" : "translated", "value" : "Breathe автоматично підтримує світлу й темну теми." } } } },
    "Data and privacy" : { "localizations" : { "uk" : { "stringUnit" : { "state" : "translated", "value" : "Дані та приватність" } } } },
    "Your profile and craving history stay on this device." : { "localizations" : { "uk" : { "stringUnit" : { "state" : "translated", "value" : "Ваш профіль та історія тяги залишаються на цьому пристрої." } } } },
    "This resets your quit plan. Your logged cravings are kept." : { "localizations" : { "uk" : { "stringUnit" : { "state" : "translated", "value" : "Ваш план буде скинуто, але записи про тягу збережуться." } } } },
    "A moment for you" : { "localizations" : { "uk" : { "stringUnit" : { "state" : "translated", "value" : "Мить для вас" } } } },
    "A peaceful path through green hills toward sunrise" : { "localizations" : { "uk" : { "stringUnit" : { "state" : "translated", "value" : "Спокійна стежка поміж зелених пагорбів до сходу сонця" } } } },
    "percent" : { "localizations" : { "uk" : { "stringUnit" : { "state" : "translated", "value" : "відсотків" } } } },
    "Quit smoking with a plan that adapts to you" : { "localizations" : { "uk" : { "stringUnit" : { "state" : "translated", "value" : "Киньте курити з планом, який підлаштовується під вас" } } } },
    "Breathe tracks your progress, learns your difficult moments, and helps you get through cravings before they turn into slips." : { "localizations" : { "uk" : { "stringUnit" : { "state" : "translated", "value" : "Breathe відстежує ваш прогрес, вивчає складні моменти й допомагає впоратися з тягою, перш ніж вона призведе до зриву." } } } },
    "Get Started" : { "localizations" : { "uk" : { "stringUnit" : { "state" : "translated", "value" : "Почати" } } } },
    "Your data stays on your device." : { "localizations" : { "uk" : { "stringUnit" : { "state" : "translated", "value" : "Ваші дані залишаються на пристрої." } } } },
    "Back" : { "localizations" : { "uk" : { "stringUnit" : { "state" : "translated", "value" : "Назад" } } } },
