    "Where are you in your journey?" : { "localizations" : { "uk" : { "stringUnit" : { "state" : "translated", "value" : "На якому ви зараз етапі?" } } } },
    "I already quit" : { "localizations" : { "uk" : { "stringUnit" : { "state" : "translated", "value" : "Я вже не курю" } } } },
    "I’m quitting today" : { "localizations" : { "uk" : { "stringUnit" : { "state" : "translated", "value" : "Я кидаю сьогодні" } } } },
    "We’ll use this date to calculate your smoke-free progress." : { "localizations" : { "uk" : { "stringUnit" : { "state" : "translated", "value" : "За цією датою ми розрахуємо ваш прогрес без куріння." } } } },
    "Tell us about your previous routine" : { "localizations" : { "uk" : { "stringUnit" : { "state" : "translated", "value" : "Розкажіть про свій попередній режим" } } } },
    "This helps calculate cigarettes avoided and money saved." : { "localizations" : { "uk" : { "stringUnit" : { "state" : "translated", "value" : "Це допоможе підрахувати невикурені цигарки та заощаджені гроші." } } } },
    "When did you usually smoke your first cigarette?" : { "localizations" : { "uk" : { "stringUnit" : { "state" : "translated", "value" : "Коли ви зазвичай викурювали першу цигарку?" } } } },
    "Within 5 minutes after waking" : { "localizations" : { "uk" : { "stringUnit" : { "state" : "translated", "value" : "Упродовж 5 хвилин після пробудження" } } } },
