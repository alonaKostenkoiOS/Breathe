    "Recovery is personal" : { "localizations" : { "uk" : { "stringUnit" : { "state" : "translated", "value" : "Відновлення в кожного своє" } } } },
    "Health recovery times are estimates and can vary from person to person." : { "localizations" : { "uk" : { "stringUnit" : { "state" : "translated", "value" : "Терміни відновлення є орієнтовними й можуть відрізнятися для кожної людини." } } } },
